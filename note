import cv2
import numpy as np
import matplotlib.pyplot as plt

def analyze_tray_and_coins(image_path):
    # Wczytanie obrazu
    img = cv2.imread(image_path)
    if img is None:
        print(f"Nie udało się wczytać obrazu: {image_path}")
        return
    
    # Kopia obrazu dla rysowania i konwersja do RGB (dla Matplotliba)
    img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    
    # Konwersja do skali szarości i rozmycie w celu redukcji szumów
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    blurred = cv2.GaussianBlur(gray, (7, 7), 1.5)
    
    # ---------------------------------------------------------
    # 1. Wyznaczenie konturu tacki [Zadanie 1]
    # ---------------------------------------------------------
    # Zastosowanie detekcji krawędzi Canny lub progowania (może wymagać dostrojenia do Twoich zdjęć)
    edges = cv2.Canny(blurred, 50, 150)
    
    # Operacje morfologiczne, aby połączyć krawędzie tacki
    kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (5, 5))
    closed = cv2.morphologyEx(edges, cv2.MORPH_CLOSE, kernel, iterations=2)
    
    # Znalezienie konturów
    contours, _ = cv2.findContours(closed, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    
    # Zakładamy, że największy znaleziony kontur to nasza tacka
    if contours:
        tray_contour = max(contours, key=cv2.contourArea)
        cv2.drawContours(img_rgb, [tray_contour], -1, (0, 255, 0), 3) # Zielona linia dla tacki
    else:
        print("Nie znaleziono tacki.")
        return
    
    # ---------------------------------------------------------
    # 2. Obliczenie pola powierzchni konturu tacki [Zadanie 2]
    # ---------------------------------------------------------
    tray_area = cv2.contourArea(tray_contour)
    
    # ---------------------------------------------------------
    # 3. Wykrycie monet - Transformata Hougha [Zadanie 3]
    # ---------------------------------------------------------
    # UWAGA: Parametry param1, param2, minRadius i maxRadius musisz prawdopodobnie 
    # dostroić (zmieniać) pod kątem rozdzielczości zdjęć tray1...tray8!
    circles = cv2.HoughCircles(
        blurred, 
        cv2.HOUGH_GRADIENT, 
        dp=1.2, 
        minDist=40,       # Minimalny dystans pomiędzy środkami monet
        param1=50,        # Czułość Canny używana przez Hough
        param2=30,        # Próg dla akceptacji środka monety (im niższy, tym więcej fałszywych okręgów)
        minRadius=20,     # Minimalny promień monety
        maxRadius=80      # Maksymalny promień monety
    )
    
    # Zmienne do zliczania i kwot [Zadanie 4 i 5]
    large_on_tray = 0
    small_on_tray = 0
    large_off_tray = 0
    small_off_tray = 0
    
    # Konfiguracja nominałów (przykład: duża=5zł, mała=1zł) - do podmiany po analizie zdjęć!
    VAL_LARGE = 5.0 
    VAL_SMALL = 1.0 
    
    if circles is not None:
        circles = np.uint16(np.around(circles))
        for i in circles[0, :]:
            center = (i[0], i[1]) # x, y
            radius = i[2]
            
            # Sprawdzenie, czy środek monety leży wewnątrz wielokąta tacki 
            # Funkcja zwraca: +1 (wewnątrz), 0 (na krawędzi), -1 (na zewnątrz)
            is_inside = cv2.pointPolygonTest(tray_contour, center, measureDist=False) >= 0
            
            # Klasyfikacja rozmiaru - próg wielkości promienia do ustawienia!
            # Jeśli np. próg to 45 pikseli:
            threshold_radius = 45 
            is_large = radius > threshold_radius
            
            # ---------------------------------------------------------
            # 4. Zliczenie monet (dużych/małych) na tacce / poza [Zadanie 4]
            # ---------------------------------------------------------
            if is_inside:
                if is_large:
                    large_on_tray += 1
                    color = (255, 0, 0) # Czerwony dla dużych na tacce
                else:
                    small_on_tray += 1
                    color = (255, 150, 0) # Pomarańczowy dla małych na tacce
            else:
                if is_large:
                    large_off_tray += 1
                    color = (0, 0, 255) # Niebieski dla dużych poza
                else:
                    small_off_tray += 1
                    color = (0, 255, 255) # Jasnoniebieski dla małych poza
            
            # Narysowanie okręgu oraz jego środka na obrazie wynikowym
            cv2.circle(img_rgb, center, radius, color, 3)
            cv2.circle(img_rgb, center, 2, (255, 0, 255), 3)

    # ---------------------------------------------------------
    # 5. Obliczenie kwoty pieniędzy na tacce / poza tacką [Zadanie 5]
    # ---------------------------------------------------------
    money_on_tray = (large_on_tray * VAL_LARGE) + (small_on_tray * VAL_SMALL)
    money_off_tray = (large_off_tray * VAL_LARGE) + (small_off_tray * VAL_SMALL)
    
    # ---------------------------------------------------------
    # WYŚWIETLANIE W JUPYTER NOTEBOOKU
    # ---------------------------------------------------------
    plt.figure(figsize=(12, 10))
    plt.imshow(img_rgb)
    
    # Konstrukcja tytułu wyświetlającego wszystkie wymagane dane
    title_text = (
        f"1&2. Pole tacki: {tray_area:.0f} px\n"
        f"4. Zliczenie:\n"
        f"   Na tacce: {large_on_tray} dużych, {small_on_tray} małych\n"
        f"   Poza tacką: {large_off_tray} dużych, {small_off_tray} małych\n"
        f"5. Pieniądze:\n"
        f"   Kwota na tacce: {money_on_tray} PLN | Kwota poza: {money_off_tray} PLN"
    )
    plt.title(title_text, loc='left', fontsize=12)
    plt.axis('off')
    plt.show()

# Pętla przez wszystkie obrazy opisane w poleceniu
for i in range(1, 9):
    file_name = f"tray{i}.jpg"
    print(f"Analiza pliku: {file_name}")
    # Odkometuj poniższą linię, gdy będziesz miał już pliki w tym samym folderze
    # analyze_tray_and_coins(file_name)